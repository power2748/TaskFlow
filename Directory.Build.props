<Project>

	<!-- Общие свойства для всех проектов -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Централизованное управление версиями пакетов -->
	<ItemGroup>
		<!-- Aspire -->
		<PackageReference Update="Aspire.Hosting" Version="13.4.3" />
		<PackageReference Update="Aspire.Hosting.AppHost" Version="13.4.3" />
		<PackageReference Update="Aspire.Hosting.PostgreSQL" Version="13.4.3" />

		<!-- YARP -->
		<PackageReference Update="Yarp.ReverseProxy" Version="2.3.0" />

		<!-- Wolverine -->
		<PackageReference Update="WolverineFx" Version="6.8.0" />
		<PackageReference Update="WolverineFx.Http" Version="6.8.0" />

		<!-- Auth -->
		<PackageReference Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />

		<!-- EF Core -->
		<PackageReference Update="Microsoft.EntityFrameworkCore" Version="10.0.9" />
		<PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
		<PackageReference Update="Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.3" />
	</ItemGroup>

</Project>
