@using System.Security.Claims;

@page "/dashboard"
@attribute [Authorize]
@inject HttpClient Http
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="main-block">
    <nav>
        <div class="nav-main">
            <div class="title">
                <h1>TaskFlow</h1>
            </div>
            <div class="exit-btn">
                <button @onclick="LogoutAsync">Выйти</button>
            </div>
        </div>
    </nav>

    <div class="task-title">
        <h3>Личные задачи</h3>
        <button @onclick='() => Nav.NavigateTo("/tasks/create")'>Создать задачу</button>
    </div>

    <div class="task-block">
        @if (personalTasks is null)
        {
            <p>Загрузка...</p>
        }
        else if (!personalTasks.Any())
        {
            <p>Нет личных задач</p>
        }
        else
        {
            <div class="kanban-board">
                <div class="kanban-column"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(TaskStatus.ToDo)">
                    <div class="column-header todo">Нужно сделать</div>
                    <div class="column-body">
                        @foreach (var task in personalTasks.Where(t => t.Status == TaskStatus.ToDo))
                        {
                            <div class="task-card" draggable="true" @ondragstart="() => HandleDragStart(task)">
                                <div class="task">
                                    <b>@task.Title</b> — @(task.Status == TaskStatus.Done ? "✅" : "⏳")
                                    <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                                        (@task.AssignedUserEmail)
                                    </span>
                                    <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                                        Редактировать
                                    </button>
                                    <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">❌</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="kanban-column"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(TaskStatus.InProgress)">
                    <div class="column-header in-progress">В процессе</div>
                    <div class="column-body">
                        @foreach (var task in personalTasks.Where(t => t.Status == TaskStatus.InProgress))
                        {
                            <div class="task-card" draggable="true" @ondragstart="() => HandleDragStart(task)">
                                <div class="task">
                                    <b>@task.Title</b> — @(task.Status == TaskStatus.Done ? "✅" : "⏳")
                                    <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                                        (@task.AssignedUserEmail)
                                    </span>
                                    <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                                        Редактировать
                                    </button>
                                    <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">❌</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="kanban-column"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(TaskStatus.CodeReview)">
                    <div class="column-header review">На проверке</div>
                    <div class="column-body">
                        @foreach (var task in personalTasks.Where(t => t.Status == TaskStatus.CodeReview))
                        {
                            <div class="task-card" draggable="true" @ondragstart="() => HandleDragStart(task)">
                                <div class="task">
                                    <b>@task.Title</b> — @(task.Status == TaskStatus.Done ? "✅" : "⏳")
                                    <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                                        (@task.AssignedUserEmail)
                                    </span>
                                    <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                                        Редактировать
                                    </button>
                                    <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">❌</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="kanban-column"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(TaskStatus.Done)">
                    <div class="column-header done">Готово</div>
                    <div class="column-body">
                        @foreach (var task in personalTasks.Where(t => t.Status == TaskStatus.Done))
                        {
                            <div class="task-card card-done" draggable="true" @ondragstart="() => HandleDragStart(task)">
                                <div class="task">
                                    <b>@task.Title</b> — @(task.Status == TaskStatus.Done ? "✅" : "⏳")
                                    <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                                        (@task.AssignedUserEmail)
                                    </span>
                                    <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                                        Редактировать
                                    </button>
                                    <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">❌</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            @* @foreach (var task in personalTasks)
            {
                <div class="task">
                    <b>@task.Title</b> — @(task.Status == TaskStatus.Done ? "✅" : "⏳")
                    <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                        (@task.AssignedUserEmail)
                    </span>
                    <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                        Редактировать
                    </button>
                    <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">❌</button>
                </div>
            } *@
        }
    </div>

    <div class="project-title">
        <h3>Мои проекты</h3>
        <button @onclick='() => Nav.NavigateTo("/projects/create")'>Создать проект</button>
    </div>

    <div class="project-block">
        @if (projects is null)
        {
            <p>Загрузка...</p>
        }
        else if (!projects.Any())
        {
            <p>У вас пока нет проектов</p>
        }
        else
        {
            @foreach (var project in projects)
            {
                <div class="project">
                    <div>
                        <b>@project.Name</b>
                        <span style="color:gray; margin-left:10px;">
                            Участников: @project.Members.Count
                        </span>
                        <button @onclick='() => Nav.NavigateTo($"/projects/{project.Id}")'>
                            Открыть
                        </button>
                        @if (project.OwnerId == currentUserId)
                        {
                            <button @onclick="() => DeleteProjectAsync(project.Id)"
                                    style="color:red; margin-left:5px;">
                                ❌
                            </button>
                        }
                    </div>

                    @* Задачи этого проекта *@
                    @{
                        var thisProjectTasks = projectTasks
                            .Where(t => t.ProjectId == project.Id)
                            .ToList();
                    }
                    @if (thisProjectTasks.Any())
                    {
                        <div style="margin-left: 20px; margin-top: 8px;">
                            @foreach (var task in thisProjectTasks)
                            {
                                <div class="task">
                                    <b>@task.Title</b> — @(task.Status == TaskStatus.Done ? "✅" : "⏳")
                                    @if (!string.IsNullOrEmpty(task.AssignedUserEmail))
                                    {
                                        <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                                            (@task.AssignedUserEmail)
                                        </span>
                                    }
                                    <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                                        Редактировать
                                    </button>
                                    <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">❌</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="margin-left: 20px; color: gray; font-size: 0.9em;">Нет задач в проекте</p>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    List<TaskDto>? allTasks;
    List<TaskDto> personalTasks = new();
    List<TaskDto> projectTasks = new();
    List<ProjectDto>? projects;
    private TaskDto? draggedTask;
    Guid currentUserId;
    public enum TaskStatus
    {
        ToDo = 0,
        InProgress = 1,
        CodeReview = 2,
        Done = 3
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userIdStr))
        {
            Nav.NavigateTo("/login");
            return;
        }

        currentUserId = Guid.Parse(userIdStr);

        allTasks = await Http.GetFromJsonAsync<List<TaskDto>>($"/api/tasks/{currentUserId}");

        if (allTasks != null)
        {
            personalTasks = allTasks.Where(t => t.ProjectId == null).ToList();
            projectTasks = allTasks.Where(t => t.ProjectId != null).ToList();
        }

        projects = await Http.GetFromJsonAsync<List<ProjectDto>>($"/api/projects/{currentUserId}");
    }

    async Task DeleteProjectAsync(Guid projectId)
    {
        await Http.DeleteAsync($"/api/projects/{projectId}");
        Nav.NavigateTo("/dashboard", forceLoad: true);
    }

    async Task LogoutAsync()
    {
        await AuthProvider.ClearTokenAsync();
        Nav.NavigateTo("/login");
    }

    async Task DeleteTaskAsync(Guid taskId)
    {
        var response = await Http.DeleteAsync($"/api/tasks/{taskId}");
        if (response.IsSuccessStatusCode)
        {
            personalTasks = personalTasks.Where(t => t.Id != taskId).ToList();
            projectTasks = projectTasks.Where(t => t.Id != taskId).ToList();
            allTasks = personalTasks.Concat(projectTasks).ToList();
        }
    }

    private void HandleDragStart(TaskDto task)
    {
        draggedTask = task;
    }

    // Метод срабатывает, когда пользователь отпустил карточку над какой-то колонкой
    private async Task HandleDrop(TaskStatus newStatus)
    {
        if (draggedTask != null && draggedTask.Status != newStatus)
        {
            // 1. Запоминаем старый статус на случай сбоя сети
            var oldStatus = draggedTask.Status;

            // 2. Оптимистичный UI: сразу меняем статус на фронте, чтобы не было задержек
            draggedTask.Status = newStatus;

            // 3. Отправляем PUT-команду на бэкенд в Wolverine
            var response = await Http.PutAsJsonAsync("/api/tasks/status", new
            {
                TaskId = draggedTask.Id,
                NewStatus = newStatus
            });

            if (!response.IsSuccessStatusCode)
            {
                // Если бэкенд вернул ошибку, откатываем статус назад
                draggedTask.Status = oldStatus;
                StateHasChanged();
            }

            draggedTask = null;
        }
    }

    public class TaskDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public TaskStatus Status { get; set; } // Теперь менять можно!
        public string AssignedUserEmail { get; set; } = string.Empty;
        public Guid? ProjectId { get; set; }
    }
    record ProjectDto(Guid Id, string Name, Guid OwnerId, List<ProjectMemberDto> Members);
    record ProjectMemberDto(Guid UserId, string Email);
}