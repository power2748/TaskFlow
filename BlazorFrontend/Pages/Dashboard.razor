@using System.Security.Claims;

@page "/dashboard"
@attribute [Authorize]
@inject HttpClient Http
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<h3>Мои задачи</h3>
<button @onclick='() => Nav.NavigateTo("/tasks/create")'>Создать задачу</button>
<button @onclick="LogoutAsync">Выйти</button>

@if (tasks is null)
{
    <p>Загрузка...</p>
}
else
{
    @foreach (var task in tasks)
    {
        <div style="margin-bottom: 10px; padding: 10px; border-bottom: 1px solid #eee;">
            <b>@task.Title</b> — @(task.IsCompleted ? "✅" : "⏳")

            @if (!string.IsNullOrEmpty(task.AssignedUserEmail))
            {
                <span style="font-size: 0.8em; color: gray; margin-left: 10px;">
                    (@task.AssignedUserEmail)
                </span>
            }

            <button @onclick='() => Nav.NavigateTo($"/tasks/{task.Id}")' style="margin-left: 10px;">
                Редактировать
            </button>
            <button @onclick="() => DeleteTaskAsync(task.Id)" style="color: red; margin-left: 5px;">
                ❌
            </button>
        </div>
    }
}

@code {
    List<TaskDto>? tasks;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        var userId = authState.User
            .FindFirst(ClaimTypes.NameIdentifier)?
            .Value;

        if (string.IsNullOrEmpty(userId))
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Обычный рабочий запрос без отлова 401
        tasks = await Http.GetFromJsonAsync<List<TaskDto>>($"/api/tasks/{userId}");
    }

    async Task LogoutAsync()
    {
        await AuthProvider.ClearTokenAsync();
        Nav.NavigateTo("/login");
    }

    async Task DeleteTaskAsync(Guid taskId)
    {
        // Отправляем DELETE запрос на шлюз
        var response = await Http.DeleteAsync($"/api/tasks/{taskId}");

        if (response.IsSuccessStatusCode)
        {
            // Если в базе удалилось успешно, убираем задачу из интерфейса
            if (tasks != null)
            {
                var taskToRemove = tasks.FirstOrDefault(t => t.Id == taskId);
                if (taskToRemove != null)
                {
                    tasks.Remove(taskToRemove);
                }
            }
        }
        else
        {
            Console.WriteLine("Не удалось удалить задачу на бэкенде");
        }
    }
    record TaskDto(Guid Id, string Title, bool IsCompleted, string AssignedUserEmail);
}